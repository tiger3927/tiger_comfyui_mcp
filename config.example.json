{
  "comfyui_instances": [
    {
      "name": "instance-1",
      "url": "https://your-comfyui.example.com",
      "password": "YOUR_COMFYUI_PASSWORD"
    },
    {
      "name": "instance-2",
      "url": "http://your-second-comfyui.example.com:8188",
      "password": "YOUR_COMFYUI_PASSWORD_2",
      "workflow_rules": {
        "exclude": ["*video*"],
        "only": ["hello"]
      }
    }
  ],
  "default_instance": "instance-1",
  "allowed_workflows": ["hello", "your_workflow_name"],
  "routing": {
    "weights": { "pending": 1.0, "running": 2.0 }
  },
  "server": {
    "host": "0.0.0.0",
    "port": 18800,
    "public_base_url": "http://CHANGE_ME_PUBLIC_HOST:18800",
    "mcp_allowed_hosts": ["127.0.0.1", "127.0.0.1:*", "localhost", "localhost:*", "CHANGE_ME_PUBLIC_IP", "CHANGE_ME_PUBLIC_IP:*"],
    "mcp_allowed_origins": [],
    "upload_max_per_ip": 300,
    "upload_window_s": 3600
  },
  "command_token": "CHANGE_ME_FULL_ACCESS_TOKEN",
  "query_token": "CHANGE_ME_READ_ONLY_TOKEN",
  "workflows_dir": "workflows",
  "output_dir": "output",
  "log_dir": "log",
  "output_retention_days": 7,
  "cleanup_interval_hours": 6,
  "task_retention_hours": 24,
  "task_max_retained": 200,
  "portal": {
    "db_path": "portal.db",
    "rmb_per_credit": 0.01,
    "recharge_min": 1,
    "recharge_max": 5000,
    "recharge_auto_credit": true,
    "order_timeout_s": 600,
    "sync_interval_s": 5,
    "max_active_per_user": 1,
    "jwt_ttl_hours": 72,
    "jwt_secret": "CHANGE_ME_PORTAL_JWT_SECRET_MIN_32_CHARS"
  }
}
